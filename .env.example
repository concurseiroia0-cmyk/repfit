# URL do projeto (a que você já tem):
VITE_SUPABASE_URL=https://ybhiyiobmcoszmvrwkef.supabase.co

# Chave ANÔNIMA (pública) do projeto — Painel Supabase:
# Settings → API → Project API keys → anon public
# (NUNCA coloque a service_role aqui: ela vai para o bundle do navegador!)
VITE_SUPABASE_ANON_KEY=

# E-mails com acesso TOTAL sem precisar pagar (separados por vírgula).
# O banco também guarda isso em app_config (owner_emails) — esta variável é
# usada ANTES do login (a tela de bloqueio mostra acesso garantido).
VITE_OWNER_EMAILS=juliocesa219853@gmail.com
