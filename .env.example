# ============================================================================
# RepFit — Supabase (cópie este arquivo para .env e preencha os valores)
# ============================================================================

# URL do projeto (a que você já tem):
VITE_SUPABASE_URL=https://ybhiyiobmcoszmvrwkef.supabase.co

# Chave ANÔNIMA (pública) do projeto — Painel Supabase:
# Settings → API → Project API keys → anon public
# (NUNCA coloque a service_role aqui: ela vai para o bundle do navegador!)
VITE_SUPABASE_ANON_KEY=

# E-mails com acesso TOTAL sem precisar pagar (separados por vírgula).
# O banco também guarda isso em app_config (owner_emails) — esta variável é
# usada ANTES do login (a tela de bloqueio mostra acesso garantido).
VITE_OWNER_EMAILS=juliocesa219853@gmail.com

# URL de CHECKOUT por plano (tela /planos). Cole aqui o link de pagamento
# gerado na plataforma (Kirvano/GGCheckout). Sem isso, o botão "Assinar"
# avisa que o checkout ainda não foi conectado (a liberação por webhook já
# funciona de qualquer forma).
#VITE_CHECKOUT_URL_MENSAL=https://pay.kirvano.com/seu-link-mensal
#VITE_CHECKOUT_URL_TRIMESTRAL=https://pay.kirvano.com/seu-link-trimestral
#VITE_CHECKOUT_URL_ANUAL=https://pay.kirvano.com/seu-link-anual
# Ou um único fallback para todos os planos:
#VITE_CHECKOUT_URL=https://pay.kirvano.com/seu-link
